ounded border-none","a":{"aria-label":"Pin on Pinterest","type":"button"},"ch":[{"t":"svg","a":{"viewBox":"0 0 32 32","width":"20","height":"20","fill":"white"},"ch":[{"t":"path","a":{"d":"M16 0C7.163 0 0 7.163 0 16c0 6.624 4.168 12.28 10.092 14.63-.14-1.258-.265-3.187.055-4.56.29-1.24 1.942-8.23 1.942-8.23s-.496-.992-.496-2.46c0-2.305 1.338-4.03 3.003-4.03 1.416 0 2.103 1.063 2.103 2.34 0 1.425-.908 3.56-1.378 5.538-.393 1.653.827 3 2.456 3 2.948 0 5.217-3.108 5.217-7.594 0-3.97-2.852-6.745-6.926-6.745-4.715 0-7.483 3.538-7.483 7.196 0 1.425.548 2.95 1.232 3.785.135.165.155.31.114.478-.126.52-.403 1.653-.458 1.884-.073.304-.243.368-.56.222-2.082-.97-3.383-4.017-3.383-6.463 0-5.26 3.822-10.094 11.017-10.094 5.788 0 10.285 4.125 10.285 9.635 0 5.748-3.622 10.373-8.647 10.373-1.69 0-3.28-.879-3.824-1.914l-1.038 3.876c-.376 1.448-1.39 3.263-2.072 4.368.562.174 1.155.268 1.768.268C24.837 32 32 24.837 32 16S24.837 0 16 0z"}}]}]},{"t":"button","c":"react-share__ShareButton bg-[#7F7F7F] inline-flex h-[38px] w-[38px] cursor-pointer items-center justify-center rounded border-none","a":{"aria-label":"Share by email","type":"button"},"ch":[{"t":"svg","a":{"viewBox":"0 0 32 32","width":"20","height":"20","fill":"white"},"ch":[{"t":"path","a":{"d":"M16 2C8.28 2 2 8.28 2 16s6.28 14 14 14 14-6.28 14-14S23.72 2 16 2zm6.857 8.857L16 17 9.143 10.857h13.714zM9 21V12l7 6.5 7-6.5v9H9z"}}]}]}]},{"t":"div","c":"blog_dtl_article_content _position_relative","ch":[{"t":"div","c":"ProseMirror tiptap-html ","ch":[{"t":"div","ch":[{"t":"div","c":"tiptap ProseMirror","a":{"contenteditable":"false","role":"textbox","translate":"no"},"ch":[{"t":"p","ch":[{"t":"#text","x":"Dear Expert, Founder, or CEO,"}]},{"t":"p","ch":[{"t":"#text","x":"You’re too busy to post daily. But you still need influence."}]},{"t":"p","ch":[{"t":"#text","x":"You have expertise. But it’s not visible."}]},{"t":"p","ch":[{"t":"#text","x":"You have meaningful stories. But they’re not packaged."}]},{"t":"p","ch":[{"t":"#text","x":"You want high-quality clients. But your content doesn’t reflect your depth."}]},{"t":"p","ch":[{"t":"#text","x":"Here’s the truth: You don’t need more content. You need a system."}]},{"t":"p","ch":[{"t":"#text","x":"A structured, strategic, reusable engine behind your personal brand — so you can show up consistently, confidently, and clearly."}]},{"t":"p","ch":[{"t":"#text","x":"This is the 11-Element Thought Leadership System, a framework designed to help experts build a premium personal brand without stress or guesswork."}]},{"t":"p","ch":[{"t":"#text","x":"When these elements are in place, your content becomes effortless, your voice becomes recognizable, and your brand becomes magnetic."}]},{"t":"p","ch":[{"t":"#text","x":"Let’s break down the system."}]},{"t":"p","ch":[{"t":"#text","x":"FOUNDATIONAL ELEMENTS"}]},{"t":"p","ch":[{"t":"#text","x":"1. Identity Discovery"}]},{"t":"p","ch":[{"t":"#text","x":"Before anything else, define who you are as an expert."}]},{"t":"p","ch":[{"t":"#text","x":"Questions to answer:"}]},{"t":"p","ch":[{"t":"#text","x":"What do I really do?"}]},{"t":"p","ch":[{"t":"#text","x":"What makes me different?"}]},{"t":"p","ch":[{"t":"#text","x":"What themes naturally appear when I talk?"}]},{"t":"p","ch":[{"t":"#text","x":"What do people always ask me for?"}]},{"t":"p","ch":[{"t":"#text","x":"Integrated MMC (Mentors Insight):"}]},{"t":"p","ch":[{"t":"#text","x":"Who influences my thinking?"}]},{"t":"p","ch":[{"t":"#text","x":"What philosophies shape my lens?"}]},{"t":"p","ch":[{"t":"#text","x":"Identity = clarity of expertise."}]},{"t":"p","ch":[{"t":"#text","x":"2. Purpose"}]},{"t":"p","ch":[{"t":"#text","x":"Your personal brand needs a job description."}]},{"t":"p","ch":[{"t":"#text","x":"Why are you showing up online?"}]},{"t":"p","ch":[{"t":"#text","x":"Questions to answer:"}]},{"t":"p","ch":[{"t":"#text","x":"Do I want leads?"}]},{"t":"p","ch":[{"t":"#text","x":"Visibility?"}]},{"t":"p","ch":[{"t":"#text","x":"Partnerships?"}]},{"t":"p","ch":[{"t":"#text","x":"Speaking?"}]},{"t":"p","ch":[{"t":"#text","x":"Authority?"}]},{"t":"p","ch":[{"t":"#text","x":"Opportunity?"}]},{"t":"p","ch":[{"t":"#text","x":"Integrated MMC (Models Influence):"}]},{"t":"p","ch":[{"t":"#text","x":"Whose path reflects the kind of impact I want?"}]},{"t":"p","ch":[{"t":"#text","x":"What outcomes inspire my purpose?"}]},{"t":"p","ch":[{"t":"#text","x":"Purpose = direction."}]},{"t":"p","ch":[{"t":"#text","x":"3. Positioning"}]},{"t":"p","ch":[{"t":"#text","x":"Decide what you want to be known for — and how you stand out."}]},{"t":"p","ch":[{"t":"#text","x":"Questions to answer:"}]},{"t":"p","ch":[{"t":"#text","x":"What is my expert lane?"}]},{"t":"p","ch":[{"t":"#text","x":"What transformation do I create?"}]},{"t":"p","ch":[{"t":"#text","x":"Who is my audience?"}]},{"t":"p","ch":[{"t":"#text","x":"What unique angle do I own?"}]},{"t":"p","ch":[{"t":"#text","x":"Integrated MMC (Competitor Insight):"}]},{"t":"p","ch":[{"t":"#text","x":"Who else speaks to this audience?"}]},{"t":"p","ch":[{"t":"#text","x":"What do they repeat?"}]},{"t":"p","ch":[{"t":"#text","x":"What gaps can I own?"}]},{"t":"p","ch":[{"t":"#text","x":"How can I differentiate?"}]},{"t":"p","ch":[{"t":"#text","x":"Positioning = distinction."}]},{"t":"p","ch":[{"t":"#text","x":"BRAND EXPRESSION ELEMENTS"}]},{"t":"p","ch":[{"t":"#text","x":"4. Brand Voice"}]},{"t":"p","ch":[{"t":"#text","x":"Decide how you sound online."}]},{"t":"p","ch":[{"t":"#text","x":"Warm or direct"}]},{"t":"p","ch":[{"t":"#text","x":"Formal or casual"}]},{"t":"p","ch":[{"t":"#text","x":"Structured or conversational"}]},{"t":"p","ch":[{"t":"#text","x":"Humorous or serious"}]},{"t":"p","ch":[{"t":"#text","x":"Define your tone and keep it consistent."}]},{"t":"p","ch":[{"t":"#text","x":"Brand voice = personality."}]},{"t":"p","ch":[{"t":"#text","x":"5. Visual Identity"}]},{"t":"p","ch":[{"t":"#text","x":"Define the look and feel of your brand."}]},{"t":"p","ch":[{"t":"#text","x":"Colors"}]},{"t":"p","ch":[{"t":"#text","x":"Fonts"}]},{"t":"p","ch":[{"t":"#text","x":"Layout style"}]},{"t":"p","ch":[{"t":"#text","x":"On-camera aesthetic"}]},{"t":"p","ch":[{"t":"#text","x":"Visual tone"}]},{"t":"p","ch":[{"t":"#text","x":"Visual identity = trust at first glance."}]},{"t":"p","ch":[{"t":"#text","x":"6. Archetype"}]},{"t":"p","ch":[{"t":"#text","x":"Choose your emotional positioning."}]},{"t":"p","ch":[{"t":"#text","x":"Examples: Sage, Creator, Hero, Mentor, Teacher, etc"}]},{"t":"p","ch":[{"t":"#text","x":"Your archetype influences:"}]},{"t":"p","ch":[{"t":"#text","x":"tone"}]},{"t":"p","ch":[{"t":"#text","x":"storytelling"}]},{"t":"p","ch":[{"t":"#text","x":"visuals"}]},{"t":"p","ch":[{"t":"#text","x":"presence"}]},{"t":"p","ch":[{"t":"#text","x":"Archetype = emotional clarity."}]},{"t":"p","ch":[{"t":"#text","x":"7. Boundaries"}]},{"t":"p","ch":[{"t":"#text","x":"Building a personal brand includes sharing personal details. Decide what to share and what to keep private."}]},{"t":"p","ch":[{"t":"#text","x":"Safe personal content"}]},{"t":"p","ch":[{"t":"#text","x":"Off-limits topics"}]},{"t":"p","ch":[{"t":"#text","x":"Personal boundaries"}]},{"t":"p","ch":[{"t":"#text","x":"Comfortable vulnerability levels"}]},{"t":"p","ch":[{"t":"#text","x":"Boundaries = sustainability."}]},{"t":"p","ch":[{"t":"#text","x":"INTELLECTUAL SYSTEM ELEMENTS"}]},{"t":"p","ch":[{"t":"#text","x":"8. IP Extraction (What You KNOW)"}]},{"t":"p","ch":[{"t":"#text","x":"Extract your internal knowledge — the thoughts, frameworks, and insights that make up your expertise."}]},{"t":"p","ch":[{"t":"#text","x":"Includes:"}]},{"t":"p","ch":[{"t":"#text","x":"frameworks"}]},{"t":"p","ch":[{"t":"#text","x":"principles"}]},{"t":"p","ch":[{"t":"#text","x":"models"}]},{"t":"p","ch":[{"t":"#text","x":"philosophies"}]},{"t":"p","ch":[{"t":"#text","x":"repeated lessons"}]},{"t":"p","ch":[{"t":"#text","x":"mental maps"}]},{"t":"p","ch":[{"t":"#text","x":"IP Extraction = your raw intellectual value."}]},{"t":"p","ch":[{"t":"#text","x":"9. Content Gold Mines (What You’ve CREATED)"}]},{"t":"p","ch":[{"t":"#text","x":"Collect all existing content you can repurpose."}]},{"t":"p","ch":[{"t":"#text","x":"Sources:"}]},{"t":"p","ch":[{"t":"#text","x":"slides"}]},{"t":"p","ch":[{"t":"#text","x":"emails"}]},{"t":"p","ch":[{"t":"#text","x":"workshops"}]},{"t":"p","ch":[{"t":"#text","x":"old posts"}]},{"t":"p","ch":[{"t":"#text","x":"videos"}]},{"t":"p","ch":[{"t":"#text","x":"notes"}]},{"t":"p","ch":[{"t":"#text","x":"transcripts"}]},{"t":"p","ch":[{"t":"#text","x":"drafts"}]},{"t":"p","ch":[{"t":"#text","x":"Gold Mines = your archive of reusable assets."}]},{"t":"p","ch":[{"t":"#text","x":"10. Story Bank"}]},{"t":"p","ch":[{"t":"#text","x":"Build a library of reusable stories."}]},{"t":"p","ch":[{"t":"#text","x":"Categories:"}]},{"t":"p","ch":[{"t":"#text","x":"origin"}]},{"t":"p","ch":[{"t":"#text","x":"lessons"}]},{"t":"p","ch":[{"t":"#text","x":"failures"}]},{"t":"p","ch":[{"t":"#text","x":"behind-the-scenes"}]},{"t":"p","ch":[{"t":"#text","x":"client stories"}]},{"t":"p","ch":[{"t":"#text","x":"micro-stories"}]},{"t":"p","ch":[{"t":"#text","x":"personal stories (safe)"}]},{"t":"p","ch":[{"t":"#text","x":"philosophical stories"}]},{"t":"p","ch":[{"t":"#text","x":"Story Bank = emotional connection."}]},{"t":"p","ch":[{"t":"#text","x":"11. Format and Admin"}]},{"t":"p","ch":[{"t":"#text","x":"Choose the content formats you can sustain and how you will manage the content."}]},{"t":"p","ch":[{"t":"#text","x":"Examples:"}]},{"t":"p","ch":[{"t":"#text","x":"short videos"}]},{"t":"p","ch":[{"t":"#text","x":"frameworks"}]},{"t":"p","ch":[{"t":"#text","x":"carousels"}]},{"t":"p","ch":[{"t":"#text","x":"diagrams"}]},{"t":"p","ch":[{"t":"#text","x":"storytelling posts"}]},{"t":"p","ch":[{"t":"#text","x":"long-form pieces"}]},{"t":"p","ch":[{"t":"#text","x":"Formats = consistency."}]},{"t":"p","ch":[{"t":"#text","x":"FINAL NOTE"}]},{"t":"p","ch":[{"t":"#text","x":"If you follow these 11 elements, your personal brand stops being “content creation” and becomes a thought leadership system."}]},{"t":"p","ch":[{"t":"#text","x":"To make this easier, I recorded a video walking through each element in plain, simple language."}]},{"t":"p","ch":[{"t":"#text","x":"Watch it to see the system in action."}]},{"t":"p","ch":[{"t":"#text","x":"Cheers,"}]},{"t":"p","ch":[{"t":"#text","x":"Susan PS. Would you like me to help you build your authority brand? DM me “Authority Brand.” You can also use WhatsApp: +260 777 228827 [This is not a free or low-cost offer.]"}]}]}]}]}]}]}]},{"t":"div","c":"col-12 col-md-4 col-lg-3 col-xl-3","ch":[{"t":"div","c":"blog_dtl_sidebar _mar_t40 p-4","ch":[{"t":"h4","c":"blog_dtl_sidebar_title _titl3","ch":[{"t":"#text","x":"Related Posts"}]},{"t":"ul","c":"blog_dtl_sideposts _dis_flex flex-custom-column","ch":[{"t":"li","c":"blog_dtl_sidepost _dis_flex gap-3","ch":[{"t":"a","c":"blog_dtl_sidepost_lnk","a":{"href":"/blog/are-linkedin-ads-really-the-cure-for-your-broke-ass-lead-problem"},"ch":[{"t":"img","c":"blog_dtl_sidepost_img img-fluid","a":{"src":"https://ezycourse.b-cdn.net/1887/cmj2kxotu4ivw7z9n5vmn0l6a.png","alt":"Blog featured"}},{"t":"div","c":"blog_dtl_sidepost_r8 _mar_l10","ch":[{"t":"h4","c":"blog_dtl_sidepost_title _2text_overflow","ch":[{"t":"#text","x":"ARE LINKEDIN ADS REALLY THE CURE FOR YOUR BROKE-ASS LEAD PROBLEM?"}]}]}]}]},{"t":"li","c":"blog_dtl_sidepost _dis_flex gap-3","ch":[{"t":"a","c":"blog_dtl_sidepost_lnk","a":{"href":"/blog/marketing-budget-recommendations-global-edition"},"ch":[{"t":"img","c":"blog_dtl_sidepost_img img-fluid","a":{"src":"https://ezycourse.b-cdn.net/1887/cmhmqis590meka08z90ap60jf.jpg","alt":"Blog featured"}},{"t":"div","c":"blog_dtl_sidepost_r8 _mar_l10","ch":[{"t":"h4","c":"blog_dtl_sidepost_title _2text_overflow","ch":[{"t":"#text","x":"Marketing Budget Recommendations (Global Edition)"}]}]}]}]},{"t":"li","c":"blog_dtl_sidepost _dis_flex gap-3","ch":[{"t":"a","c":"blog_dtl_sid